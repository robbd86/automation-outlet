{
  "framework": null,
  "buildCommand": "python3 build.py && python3 patch_stock.py && python3 patch_network.py && python3 release.py && python3 patch_logo.py",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/stock/:slug",
      "destination": "/api/product-page?slug=:slug"
    },
    {
      "source": "/sitemap-stock.xml",
      "destination": "/api/stock-sitemap"
    },
    {
      "source": "/google-products.txt",
      "destination": "/api/google-products"
    }
  ]
}
