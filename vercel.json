{
  "framework": null,
  "buildCommand": "python3 build_all.py",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/stock-admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/orders-admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/buyer-network-admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/deal-desk.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/agent-desk.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/plc-audit/upload",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/plc-audit/dashboard",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/plc-audit/audits/:id",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/plc-audit-upload.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/plc-audit-dashboard.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/plc-audit-audit.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/obsolescence-check",
      "destination": "/api/network-signup?quickCheck=1"
    },
    {
      "source": "/plc-audit",
      "destination": "/plc-audit.html"
    },
    {
      "source": "/plc-audit/upload",
      "destination": "/plc-audit-upload.html"
    },
    {
      "source": "/plc-audit/dashboard",
      "destination": "/plc-audit-dashboard.html"
    },
    {
      "source": "/plc-audit/audits/:id",
      "destination": "/plc-audit-audit.html?id=:id"
    },
    {
      "source": "/api/plc-audit",
      "destination": "/api/deal-desk?plcAudit=1"
    },
    {
      "source": "/api/agents",
      "destination": "/api/deal-desk"
    },
    {
      "source": "/api/photo-agent",
      "destination": "/api/deal-desk?photo=1"
    },
    {
      "source": "/listing-image/:filename",
      "destination": "/api/deal-desk?photoImage=:filename"
    },
    {
      "source": "/api/stripe-live-webhook",
      "destination": "/api/stripe-webhook"
    },
    {
      "source": "/parts",
      "destination": "/api/catalogue?collection=all"
    },
    {
      "source": "/parts/:collection",
      "destination": "/api/catalogue?collection=:collection"
    },
    {
      "source": "/stock/:slug",
      "destination": "/api/product-page?slug=:slug"
    },
    {
      "source": "/sitemap-stock.xml",
      "destination": "/api/stock-sitemap"
    },
    {
      "source": "/google-products.xml",
      "destination": "/api/google-products-xml"
    },
    {
      "source": "/google-products.txt",
      "destination": "/api/google-products"
    }
  ]
}
